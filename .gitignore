# ============================================================
#  py++ .gitignore
#
#  ⚠️ 这个项目本地约 1.9 GB，其中绝大部分**不该进仓库**。
#     开源前请核对：`git count-objects -vH` 与 `git status` 的体积。
#     GitHub 单文件上限 100 MB，仓库超 1 GB 会拖垮 clone 体验。
# ============================================================

# ---- 项目内部记录（务必排除）----
# AI 协作记忆 / 开发日志，含内部路径、服务器细节、未公开的规划。
# 这不是代码的一部分，公开出去既无意义也有风险。
.workbuddy-ai/

# ---- 内部协作文档（不对外）----
# 这几份是开发期写给内部协作方的交接文档，含服务器路径、部署细节、
# 内部流程与未公开规划。对使用者没有价值，公开反而暴露基础设施。
docs/HANDOFF.md
docs/官网交接.md
docs/排查交接-2026-10-19.md

# ---- 便携工具链（1.4 GB）----
# 内含 gcc 14.2.0 全套（1792 个 .h、971 个 .a、73 个 exe）。
# 开源惯例是不带工具链：用户自己装 gcc，或在 Releases 里单独下载。
# 注意：仅靠下面的 *.exe 挡不住 .a/.h，必须整目录排除。
tools/

# ---- 构建产物 ----
build/
dist/

# 打包用的便携运行时与安装器（体积大，可用脚本重新生成）
dist/runtime/
dist/installer/

# ---- 图形 IDE（本仓库不含）----
# 本仓库只开源 py++ **编译器核心**（语言实现、示例、文档、测试、Web 服务）。
# WinUI 3 版 IDE 是独立项目，不在本次开源范围内。
# 若将来要开源 IDE，删掉这一行即可 —— 下面针对 bin/obj/node_modules
# 的规则已经准备好，能自动挡住 196M+109M+98M 的构建产物。
ide/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ---- py++ 运行时产物 ----
*.exe
*.o
*.obj
.pypp/
*.pypp_out/

# ⚠️ 生成的 C 代码不纳入版本控制。
#    若将来手写 .c 源文件，请用 !path/to/file.c 单独放行。
*.c

# ---- 编辑器 ----
.vscode/
.idea/
*.swp
*~

# ---- 本地发布工具（不进仓库）----
# 推送脚本是给本机用的，别人 clone 下来用不到。
push-*.bat
start-ide.bat

# ---- 自检 / 临时 ----
*.log
*.tmp
Thumbs.db
desktop.ini
.DS_Store
